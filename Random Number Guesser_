import math
import random


print("Wlelcome to the Random Number Guesser!")
print("I will generate a random number between 1 and 100, and you have to guess it.")
ready = input("Are you ready to play? (yes/no): ")
if ready == "yes":
    ready_bool = True
while ready_bool:
    random_number = random.randint(1, 100)
    attempts = 0
    guess = 0

    while guess != random_number:
        guess = int(input("Enter your guess (between 1 and 100): "))
        attempts += 1

        if guess < random_number:
            print("Too low! Try again.")
        elif guess > random_number:
            print("Too high! Try again.")
        else:
            print(f"Congratulations! You've guessed the number {random_number} in {attempts} attempts.")

    play_again = input("Do you want to play again? (yes/no): ")
    if play_again.lower() != "yes":
        ready_bool = False
        print("Thank you for playing! Goodbye!")

